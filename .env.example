# Copy to .env for local overrides (never commit secrets)
APP_ENV=development
APP_NAME=Local PDF Suite
APP_VERSION=1.2.0
LOG_LEVEL=INFO

# Bind address — keep 127.0.0.1 for local-only; use 0.0.0.0 for Docker/LAN
HOST=127.0.0.1
PORT=8000

# Only trust proxy headers from these IPs (comma-separated). Avoid "*" in production.
FORWARDED_ALLOW_IPS=127.0.0.1

# Capacity limits
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_REQUEST=50
MAX_PREVIEW_PAGES=30
MAX_TOTAL_PREVIEW_PAGES=500
MAX_OCR_PAGES=200
MAX_PASSWORD_LENGTH=128
MAX_ZIP_ENTRIES=10000
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_REQUEST_BYTES=576716800
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MINUTE=120
SUBPROCESS_TIMEOUT_SECONDS=180

# CORS — set to your internal origin in enterprise deployments
ALLOW_ORIGINS=*

# Optional: require X-API-Key or Authorization: Bearer <key> on /api/*
# API_KEY=change-me-to-a-long-random-secret

# Optional: restrict Host header (comma-separated)
# TRUSTED_HOSTS=pdf.internal.company,localhost,127.0.0.1

# Optional feature toggles
ENABLE_OCR=true
ENABLE_LIBREOFFICE=true
ENABLE_GHOSTSCRIPT=true
ENABLE_CAMELOT=true

# Temp directory (use a dedicated volume/tmpfs in production)
# TEMP_DIR=/tmp/pdfsuite
